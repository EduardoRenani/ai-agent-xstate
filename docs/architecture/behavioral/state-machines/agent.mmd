%% Spec: behavioral-doc.md
%% Modo: incremental
%% Atualizado: 2026-05-14
%% Fonte: src/machine.ts
%% Componente C4: machine (c2-container.mmd)
%% Container C4: system (c2-container.mmd)
%% Externos que disparam transicoes: OpenRouter API (via invoke in greetings, thinking)
stateDiagram-v2
    [*] --> idle

    idle --> greetings: MESSAGE / appendUserMessage

    greetings --> improvise: onDone / append greeting, raise PARTIALLY_RESPONDED if needsFollowUp

    state improvise {
        [*] --> listening

        listening --> thinking: PARTIALLY_RESPONDED
        listening --> thinking: MESSAGE / appendUserMessage
        thinking --> listening: onDone / print reply, append assistant message
        thinking --> listening: onError / print error
    }

    note right of greetings
        Invokes greetingsNode actor (OpenRouter API).
        Returns { greeting, needsFollowUp }.
        Raises PARTIALLY_RESPONDED only if needsFollowUp.
    end note

    note right of thinking
        Invokes improviseThinkingNode actor (OpenRouter API)
        with IMPROVISE_SYSTEM_PROMPT.
        Does not accept MESSAGE while processing.
    end note

    note right of idle
        No terminal state.
        Agent runs until process exit (Ctrl+C).
    end note
