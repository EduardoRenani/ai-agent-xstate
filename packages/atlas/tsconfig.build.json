{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "dist",
        "rootDir": "src",
        "noEmit": false,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "rewriteRelativeImportExtensions": true
    },
    "include": ["src"],
    "exclude": ["test", "**/*.test.ts"]
}
